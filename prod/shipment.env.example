# ==============================================================================
# APRIL EYEWEAR SHIPMENT SERVICE - PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Referensi variabel Shipment Service (prod). Nilai asli tersimpan di Infisical,
# folder prod:/shipment-service — file ini hanya daftar variabel (tanpa nilai asli).
# ==============================================================================

PORT=3002
NODE_ENV=production

# Database Configuration (PostgreSQL Prod VPS)
DATABASE_URL="postgresql://postgres:YOUR_STRONG_PROD_PASSWORD@localhost:5432/april_shipment_db?schema=public"

# Redis Cache for Rates API (TTL pendek — kurir non-aktif cepat hilang dari checkout)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# CORS (Origins separated by comma). aprileyewear.com = domain utama; prod.aprileyewear.com transisi.
CORS_ALLOWED_ORIGINS=https://aprileyewear.com,https://www.aprileyewear.com,https://admin.aprileyewear.com,https://smartfit.aprileyewear.com,https://prod.aprileyewear.com,https://april-eyewear-website.pages.dev

# Biteship Logistics Gateway API (Live Production Key)
BITESHIP_API_KEY=biteship_live.your_production_biteship_key_here
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_WEBHOOK_SECRET=your_production_biteship_webhook_secret
SHIPMENT_INTERNAL_TOKEN=generate_a_long_random_token

# Kurir yang TIDAK ditawarkan di checkout (pisahkan koma, kode Biteship).
# Pakai bila kurir sudah dinonaktifkan di dashboard Biteship tetapi API tarif akun masih
# mengembalikannya. Contoh: gojek,grab
RATES_EXCLUDED_COURIERS=

# Webhook ops (Discord) untuk alert: layanan tarif Biteship down / gagal terbit resi
# (indikasi saldo habis). Kosongkan untuk menonaktifkan.
ALERT_WEBHOOK_URL=

# Batas waktu panggilan HTTP ke Biteship (ms). Opsional, default 10000.
HTTP_FETCH_TIMEOUT_MS=10000

