# ==============================================================================
# APRIL EYEWEAR SHIPMENT SERVICE - PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Salin file ini menjadi prod/shipment.env lalu sesuaikan kredensial Anda.
# JANGAN PERNAH COMMIT prod/shipment.env KE REPOSITORI PUBLIK.
# ==============================================================================

PORT=3002
NODE_ENV=production

# Database Configuration (PostgreSQL Prod VPS)
DATABASE_URL="postgresql://postgres:YOUR_STRONG_PROD_PASSWORD@localhost:5432/april_shipment_db?schema=public"

# Redis Cache for Rates API (24 Hours TTL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# Biteship Logistics Gateway API (Live Production Key)
BITESHIP_API_KEY=biteship_live.your_production_biteship_key_here
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_WEBHOOK_SECRET=your_production_biteship_webhook_secret

# Origin Flagship Address (Senopati Flagship)
ORIGIN_STORE_NAME="April Eyewear Flagship Senopati"
ORIGIN_CONTACT_NAME="April Eyewear Logistics"
ORIGIN_CONTACT_PHONE="081234567890"
ORIGIN_ADDRESS="Jl. Senopati No. 42, Kebayoran Baru, Jakarta Selatan"
ORIGIN_AREA_ID="IDNP6IDNC147IDND881IDNZ12190"
ORIGIN_POSTAL_CODE="12190"
ORIGIN_LATITUDE="-6.2307"
ORIGIN_LONGITUDE="106.8123"
