# ==============================================================================
# APRIL EYEWEAR MAIN SERVICE - PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Referensi variabel Main Service (prod). Nilai asli tersimpan di Infisical,
# folder prod:/main-service — file ini hanya daftar variabel (tanpa nilai asli).
# ==============================================================================

PORT=3000
NODE_ENV=production

# CORS Configuration (Origins separated by comma)
# aprileyewear.com = domain utama (live). prod.aprileyewear.com dipertahankan selama transisi DNS.
CORS_ALLOWED_ORIGINS=https://aprileyewear.com,https://www.aprileyewear.com,https://admin.aprileyewear.com,https://smartfit.aprileyewear.com,https://prod.aprileyewear.com,https://april-eyewear-website.pages.dev

# Database Production (4 Core / 4GB RAM Dedicated Native Postgres)
DATABASE_URL="postgresql://postgres:YOUR_STRONG_PROD_PASSWORD@localhost:5432/april_eyewear_db?schema=public"

# Redis Cache & Background Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Security Credentials (Gunakan key acak yang kuat)
JWT_SECRET=generate_very_strong_random_secret_for_production_2026
JWT_EXPIRATION_TIME=900s
JWT_REFRESH_SECRET=generate_very_strong_refresh_secret_for_production_2026
JWT_REFRESH_EXPIRATION_TIME=7d

# Token akses pesanan untuk endpoint pembayaran publik (guest checkout).
# Opsional: bila kosong, otomatis memakai JWT_SECRET. Disarankan nilai acak terpisah.
ORDER_ACCESS_SECRET=generate_strong_random_secret_for_order_access_2026

# Kiosk Hardware Cryptographic Key
KIOSK_HMAC_SECRET=generate_kiosk_hardware_master_secret_prod

# Internal Microservice Integration (Shipment Service via Internal Loopback)
SHIPMENT_SERVICE_URL=http://127.0.0.1:3002
SHIPMENT_INTERNAL_TOKEN=generate_a_long_random_token
# Samakan dengan BITESHIP_WEBHOOK_SECRET di shipment.env dan URL webhook di dashboard Biteship
# (?secret=... atau header x-webhook-secret / x-callback-token). Tanpa ini webhook ditolak.
BITESHIP_WEBHOOK_SECRET=generate_a_long_random_biteship_webhook_secret

# WhatsApp Cloud Business API (Official Production Meta Credentials)
WA_CLOUD_API_TOKEN=EAA_PRODUCTION_TOKEN_HERE
WA_PHONE_NUMBER_ID=YOUR_OFFICIAL_PHONE_ID
WA_BUSINESS_ACCOUNT_ID=YOUR_OFFICIAL_WABA_ID

# AI / Google Vertex AI Vision Credentials (Production Project)
VERTEX_AI_PROJECT_ID=april-eyewear-prod
VERTEX_AI_LOCATION=asia-southeast1

# iPaymu Payment Gateway API v2
#
# JENDELA VERIFIKASI (sebelum cutover): jalankan dengan kredensial SANDBOX dulu untuk memverifikasi
# alur end-to-end di prod.aprileyewear.com. Karena NODE_ENV=production, sandbox wajib diizinkan
# eksplisit lewat IPAYMU_ALLOW_SANDBOX_IN_PROD=true (kalau tidak, boot akan gagal).
#   IPAYMU_ENV=sandbox
#   IPAYMU_BASE_URL=https://sandbox.ipaymu.com/api/v2
#   IPAYMU_ALLOW_SANDBOX_IN_PROD=true
# SAAT CUTOVER: ganti ke kredensial live di bawah dan HAPUS IPAYMU_ALLOW_SANDBOX_IN_PROD.
IPAYMU_VA=YOUR_PRODUCTION_VA_NUMBER
IPAYMU_API_KEY=PRODUCTION_IPAYMU_API_KEY_HERE
IPAYMU_ENV=production
IPAYMU_BASE_URL=https://my.ipaymu.com/api/v2
IPAYMU_ALLOW_SANDBOX_IN_PROD=
IPAYMU_CALLBACK_URL=https://api.aprileyewear.com/api/v1/payments/ipaymu/callback
STOREFRONT_URL=https://aprileyewear.com
ADMIN_URL=https://aprileyewear.com/admin

# Kebijakan metode pembayaran PER HOST (JSON) — SEMENTARA, untuk jendela verifikasi iPaymu.
# Konfigurasi pembayaran CMS bersifat global; env ini menimpanya per domain tanpa mengubah CMS.
# Kosongkan untuk mematikan kebijakan (semua host ikut konfigurasi CMS).
# Contoh: gateway+manual hanya di host verifikasi, domain utama manual-only.
PAYMENT_HOST_POLICY={"prod.aprileyewear.com":["manual","ipaymu"],"aprileyewear.com":["manual"],"www.aprileyewear.com":["manual"]}

# Signed GLB delivery for AR occluders (Cloudflare Pages Function /media/*)
# GLB_SIGNING_SECRET harus SAMA dengan GLB_SIGNING_SECRET di project Pages
# (Settings → Environment variables) untuk environment ini. Kalau berbeda, verifier
# menolak tanda tangan (403) dan klien jatuh ke fallback statis.
GLB_SIGNING_SECRET=generate_a_long_random_hex_secret
# Origin publik yang melayani Function /media/* — HARUS origin tempat project Pages
# (beserta functions/) di-deploy, tanpa trailing slash. Ikuti host storefront aktif (aprileyewear.com).
MEDIA_PUBLIC_BASE_URL=https://aprileyewear.com
# Umur URL bertanda tangan (detik). Maksimum 3600 (dipaksakan di edge).
GLB_URL_TTL_SECONDS=600

# Firebase Admin SDK Credentials (Production Project)
FIREBASE_PROJECT_ID=april-eyewear-prod
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PROD_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@april-eyewear-prod.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=april-eyewear-prod.appspot.com

# Transactional Email Engine (Resend API Live Key)
RESEND_API_KEY=re_your_live_production_key
RESEND_FROM="April Eyewear Concierge <concierge@aprileyewear.com>"

# Transactional Email Engine (SMTP Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="April Eyewear Concierge <concierge@aprileyewear.com>"

# Opsional: webhook (Discord) untuk alert error 5xx dari API. Kosongkan untuk menonaktifkan.
ALERT_WEBHOOK_URL=
