# ==============================================================================
# APRIL EYEWEAR MAIN SERVICE - PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# Salin file ini menjadi prod/main.env lalu sesuaikan kredensial Produksi Anda.
# JANGAN PERNAH COMMIT prod/main.env KE REPOSITORI PUBLIK.
# ==============================================================================

PORT=3000
NODE_ENV=production

# CORS Configuration (Origins separated by comma)
CORS_ALLOWED_ORIGINS=https://aprileyewear.com,https://admin.aprileyewear.com,https://smartfit.aprileyewear.com,https://april-eyewear-website.pages.dev

# Database Production (4 Core / 4GB RAM Dedicated Native Postgres)
DATABASE_URL="postgresql://postgres:YOUR_STRONG_PROD_PASSWORD@localhost:5432/april_eyewear_db?schema=public"

# Redis Cache & Background Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Security Credentials (Gunakan key acak yang kuat)
JWT_SECRET=generate_very_strong_random_secret_for_production_2026
JWT_EXPIRATION_TIME=900s
JWT_REFRESH_SECRET=generate_very_strong_refresh_secret_for_production_2026
JWT_REFRESH_EXPIRATION_TIME=7d

# Kiosk Hardware Cryptographic Key
KIOSK_HMAC_SECRET=generate_kiosk_hardware_master_secret_prod

# Internal Microservice Integration (Shipment Service via Internal Loopback)
SHIPMENT_SERVICE_URL=http://127.0.0.1:3002

# WhatsApp Cloud Business API (Official Production Meta Credentials)
WA_CLOUD_API_TOKEN=EAA_PRODUCTION_TOKEN_HERE
WA_PHONE_NUMBER_ID=YOUR_OFFICIAL_PHONE_ID
WA_BUSINESS_ACCOUNT_ID=YOUR_OFFICIAL_WABA_ID

# AI / Google Vertex AI Vision Credentials (Production Project)
VERTEX_AI_PROJECT_ID=april-eyewear-prod
VERTEX_AI_LOCATION=asia-southeast1

# iPaymu Payment Gateway API v2 (Production Live Mode)
IPAYMU_VA=YOUR_PRODUCTION_VA_NUMBER
IPAYMU_API_KEY=PRODUCTION_IPAYMU_API_KEY_HERE
IPAYMU_ENV=production
IPAYMU_BASE_URL=https://my.ipaymu.com/api/v2
IPAYMU_CALLBACK_URL=https://api.aprileyewear.com/api/v1/payments/ipaymu/callback
STOREFRONT_URL=https://aprileyewear.com
ADMIN_URL=https://admin.aprileyewear.com

# Firebase Admin SDK Credentials (Production Project)
FIREBASE_PROJECT_ID=april-eyewear-prod
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PROD_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@april-eyewear-prod.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=april-eyewear-prod.appspot.com

# Transactional Email Engine (Resend API Live Key)
RESEND_API_KEY=re_your_live_production_key
RESEND_FROM="April Eyewear Concierge <concierge@aprileyewear.com>"

# Transactional Email Engine (SMTP Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="April Eyewear Concierge <concierge@aprileyewear.com>"
