# ==============================================================================
# APRIL EYEWEAR - INFISICAL BOOTSTRAP CREDENTIALS (TEMPLATE)
# Salin file ini menjadi .infisical.env lalu isi dengan kredensial machine
# identity (Universal Auth) dari Infisical.
#
#   Infisical > Project > Access > Machine Identities > <identity> > Universal Auth
# ==============================================================================

INFISICAL_HOST=https://app.infisical.com
INFISICAL_PROJECT_ID=your_project_id
INFISICAL_CLIENT_ID=your_machine_identity_client_id
INFISICAL_CLIENT_SECRET=your_machine_identity_client_secret

# Environment default untuk `start-services.sh` (local dev).
INFISICAL_DEFAULT_ENV=dev
