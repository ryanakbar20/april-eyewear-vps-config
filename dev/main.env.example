# ==============================================================================
# APRIL EYEWEAR MAIN SERVICE - DEVELOPMENT ENVIRONMENT TEMPLATE (.env.example)
# Salin file ini menjadi dev/main.env lalu sesuaikan kredensial Anda.
# ==============================================================================

PORT=3000
NODE_ENV=development

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://april-eyewear-website.pages.dev,https://aprileyewear.com,https://admin.aprileyewear.com,http://localhost:5173,http://localhost:5777

DATABASE_URL="postgresql://postgres:YOUR_DEV_PASSWORD@localhost:5432/april_dev_db?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

JWT_SECRET=your_dev_jwt_secret_key
JWT_EXPIRATION_TIME=900s
JWT_REFRESH_SECRET=your_dev_jwt_refresh_secret
JWT_REFRESH_EXPIRATION_TIME=7d

KIOSK_HMAC_SECRET=your_kiosk_hmac_secret
# Internal Microservice Integration (Shipment Service via Internal Loopback)
SHIPMENT_SERVICE_URL=http://127.0.0.1:3002

WA_CLOUD_API_TOKEN=your_wa_token
WA_PHONE_NUMBER_ID=your_wa_phone_id
WA_BUSINESS_ACCOUNT_ID=your_wa_business_id

VERTEX_AI_PROJECT_ID=april-eyewear-ai
VERTEX_AI_LOCATION=asia-southeast1

IPAYMU_VA=0000005776647086
IPAYMU_API_KEY=SANDBOX_YOUR_KEY
IPAYMU_ENV=sandbox
IPAYMU_BASE_URL=https://sandbox.ipaymu.com/api/v2
IPAYMU_CALLBACK_URL=https://dev-api.aprileyewear.com/api/v1/payments/ipaymu/callback
STOREFRONT_URL=https://april-eyewear-website.pages.dev
ADMIN_URL=https://april-eyewear-website.pages.dev/admin

FIREBASE_PROJECT_ID=april-eyewear-dev
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_DEV_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@april-eyewear-dev.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=april-eyewear-dev.firebasestorage.app

RESEND_API_KEY=re_your_test_key
RESEND_FROM="April Eyewear <no-reply@aprileyewear.com>"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="April Eyewear Concierge <concierge@aprileyewear.com>"
