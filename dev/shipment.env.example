PORT=3002
NODE_ENV=development
CORS_ALLOWED_ORIGINS=https://april-eyewear-website.pages.dev,https://aprileyewear.com,https://admin.aprileyewear.com,http://localhost:5173,http://localhost:5777

DATABASE_URL="postgresql://postgres:YOUR_DEV_PASSWORD@localhost:5432/april_shipment_db?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

BITESHIP_API_KEY=biteship_test.your_test_key_here
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_WEBHOOK_SECRET=biteship_webhook_secret_dev
SHIPMENT_INTERNAL_TOKEN=generate_a_long_random_token

ORIGIN_STORE_NAME="April Eyewear Flagship Senopati"
ORIGIN_CONTACT_NAME="April Eyewear Logistics"
ORIGIN_CONTACT_PHONE="081234567890"
ORIGIN_ADDRESS="Jl. Senopati No. 42, Kebayoran Baru, Jakarta Selatan"
ORIGIN_AREA_ID="IDNP6IDNC147IDND881IDNZ12190"
ORIGIN_POSTAL_CODE="12190"
ORIGIN_LATITUDE="-6.2307"
ORIGIN_LONGITUDE="106.8123"
