# ==============================================================================
# APRIL EYEWEAR - INFRASTRUCTURE & DEPLOYMENT CONFIGURATION (EXAMPLE TEMPLATE)
# ==============================================================================
# Salin file ini menjadi .env dan isi dengan kredensial Anda.
# ==============================================================================

# 1. CLOUDFLARE R2 STORAGE (BACKUP DATABASE & ASSET CDN)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_BACKUP=april-eyewear-backups
R2_BUCKET_MEDIA=april-eyewear-media
R2_S3_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://assets.aprileyewear.com
CLOUDFLARE_API_TOKEN=your_cloudflare_dns_edit_api_token
CLOUDFLARE_ZONE_ID=optional_zone_id_or_leave_empty_for_autodetect

# 2. GITHUB & CI/CD DEPLOYMENT
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_OWNER=ryanakbar20
GITHUB_REPO_MAIN=april-eyewear-main-service
GITHUB_REPO_SHIPMENT=april-eyewear-shipment-service

# 3. VPS PRODUCTION (4 Core / 4GB RAM)
PROD_VPS_IP=your_production_vps_ip
PROD_VPS_PORT=22
PROD_VPS_USER=ubuntu
PROD_VPS_SSH_KEY_PATH=~/.ssh/id_rsa
PROD_API_DOMAIN=api.aprileyewear.com
PROD_DEPLOY_DIR=/var/www/april-eyewear
PROD_DB_NAME=april_eyewear_db
PROD_DB_USER=postgres
PROD_DB_PASSWORD=your_secure_prod_password
PROD_DB_PORT=5432

# 4. VPS DEVELOPMENT / STAGING (1 Core / 1GB RAM)
DEV_VPS_IP=your_dev_vps_ip
DEV_VPS_PORT=22
DEV_VPS_USER=ubuntu
DEV_VPS_SSH_KEY_PATH=~/.ssh/id_rsa
DEV_API_DOMAIN=dev-api.aprileyewear.com
DEV_DEPLOY_DIR=/var/www/april-eyewear-dev
DEV_DB_NAME=april_dev_db
DEV_DB_USER=postgres
DEV_DB_PASSWORD=your_secure_dev_password
DEV_DB_PORT=5432

# 5. ALERTING & NOTIFICATION (OPSIONAL)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
